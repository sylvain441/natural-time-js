{
  "name": "natural-time-js",
  "version": "3.0.1",
  "description": "Natural Time, the reference implementation: the day in 360 degrees of sun at your longitude, the year in 13 moons of 28 days from the winter solstice. https://naturaltime.app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "vectors": "tsc && node vectors/generate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvain441/natural-time-js.git"
  },
  "keywords": [
    "Time",
    "Nature",
    "Earth",
    "Date",
    "Natural Time"
  ],
  "author": "Sylvain 441",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/sylvain441/natural-time-js/issues"
  },
  "homepage": "https://github.com/sylvain441/natural-time-js#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  }
}
